# Audio
persist.vendor.audio.fluence.audiorec=true

# Camera
persist.camera.stats.test=5
persist.camera.HAL3.enabled=1
persist.vendor.camera.dual.isp.sync=0
persist.vendor.camera.HAL3.enabled=1
persist.vendor.camera.exif.make=Xiaomi
persist.camera.gyro.disable=0
persist.camera.isp.clock.optmz=0
persist.camera.isp.turbo=1
persist.vendor.camera.HAL3.enabled=1
persist.vendor.camera.depth.focus.cb=0
persist.vendor.camera.eis.enable=1
persist.vendor.camera.expose.aux=1
persist.vendor.camera.linkpreview=0
persist.vendor.camera.perflock.enable=0
persist.vendor.camera.preview.ubwc=0

# Bluetooth
bluetooth.device.default_name=Xiaomi Mi PAD 4

# DPI
vendor.display.lcd_density=320

# Fingerprint
persist.vendor.fingerprint.type=home

# Lockscreen rotation (requested by ibooth2004@XDA (https://forum.xda-developers.com/showpost.php?p=82157253&postcount=545)
lockscreen.rot_override=true

# Single SIM
persist.radio.multisim.config=ssss

# Ultra Sound
audio.chk.cal.us=0
